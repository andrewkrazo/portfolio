# Powers the ask bar. Without it the bar says it isn't switched on yet; the rest of the site works.
ANTHROPIC_API_KEY=

# Optional: makes the ask bar's limits survive restarts. Added for you when you connect
# Upstash Redis in Vercel. Without these the limits are kept in memory instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
